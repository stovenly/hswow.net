{
  "name": "hswow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Here Stands What Once Was",
  "scripts": {
    "dev": "vite",
    "worklets": "node --check src/audio/faust/processor.js && node --check src/audio/voice/processor.js && node --check src/audio/particles/processor.js",
    "build": "npm run worklets && tsc --noEmit && vite build --mode debug",
    "deploy": "node scripts/deploy.mjs",
    "preview": "vite preview --outDir docs/debug",
    "check:movement": "esbuild projects/debug/tools/movement-check.ts --bundle --alias:@engine=./src --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/movement-check.mjs && node node_modules/.cache/movement-check.mjs",
    "check:audio": "esbuild tools/audio-check.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/audio-check.mjs && node node_modules/.cache/audio-check.mjs",
    "check": "npm run check:movement && npm run check:audio && npm run check:faust",
    "build:faust": "esbuild tools/faust-build.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/faust-build.mjs && node node_modules/.cache/faust-build.mjs",
    "render:footsteps": "esbuild tools/footstep-render.ts --bundle --platform=node --format=esm --log-level=warning --external:node-web-audio-api --outfile=node_modules/.cache/footstep-render.mjs && node node_modules/.cache/footstep-render.mjs",
    "check:faust": "esbuild tools/faust-check.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/faust-check.mjs && node node_modules/.cache/faust-check.mjs",
    "check:glsl": "esbuild tools/glsl-check.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/glsl-check.mjs && node node_modules/.cache/glsl-check.mjs"
  },
  "devDependencies": {
    "@grame/faustwasm": "^0.16.6",
    "@types/node": "^22.20.1",
    "@types/three": "^0.170.0",
    "node-web-audio-api": "^1.0.9",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.170.0"
  }
}
