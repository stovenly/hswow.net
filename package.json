{
  "name": "hswow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Heaven Sleeps Within Our Wounds",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --outDir docs",
    "check:movement": "esbuild tools/movement-check.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/movement-check.mjs && node node_modules/.cache/movement-check.mjs",
    "check:audio": "esbuild tools/audio-check.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/audio-check.mjs && node node_modules/.cache/audio-check.mjs",
    "check:art": "esbuild tools/art-check.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/art-check.mjs && node node_modules/.cache/art-check.mjs",
    "check": "npm run check:movement && npm run check:audio && npm run check:art"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.170.0"
  }
}
