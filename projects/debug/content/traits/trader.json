{
  "id": "trader",
  "name": "Trader",
  "topics": [
    {
      "key": "trade",
      "label": "Trade",
      "infos": [
        {
          "when": {
            "not": {
              "flag": "trader-gift"
            }
          },
          "reply": "You have the look of somebody with nothing to trade. Here, take the candle and go.",
          "then": [
            {
              "do": "giveItem",
              "builder": "candle"
            },
            {
              "do": "setFlag",
              "flag": "trader-gift"
            }
          ]
        },
        {
          "reply": "You have had your charity for the week. Come back with something to swap."
        }
      ]
    },
    {
      "key": "prices",
      "label": "Prices",
      "infos": [
        {
          "when": {
            "ambient": "rain",
            "min": 0.2
          },
          "reply": "Everything is dearer in the wet. The road out is mud and the mud is my cost."
        },
        {
          "reply": "Fair, mostly. Fairer than the gate men, and they have the nerve to weigh it twice."
        }
      ]
    },
    {
      "key": "give-back",
      "label": "Give the candle back",
      "when": {
        "flag": "trader-gift"
      },
      "infos": [
        {
          "when": {
            "carries": "candle"
          },
          "reply": "Changed your mind. Well, it is mine again and you are no richer for it.",
          "then": [
            {
              "do": "takeItem",
              "builder": "candle"
            },
            {
              "do": "setFlag",
              "flag": "trader-gift",
              "on": false
            }
          ]
        },
        {
          "reply": "Give it back with what? Your hands are empty. Find it, or find your way out."
        }
      ]
    }
  ]
}
