{
  "id": "wats-debt",
  "name": "What Wat Owes",
  "cast": {
    "creditor": "mark",
    "debtor": "wat"
  },
  "stages": [
    {
      "at": 10,
      "log": "Mark says Wat, in the hut up the lane, owes him for two winters of candles. I am to stand in Wat's door until he pays."
    },
    {
      "at": 20,
      "log": "Wat says Mark weighed it twice and he paid twice. Mark can have the rest when he gives one of them back."
    },
    {
      "at": 25,
      "log": "Wat gave me back the candle Mark sold him, and said Mark can choke on it."
    },
    {
      "at": 30,
      "ends": true,
      "log": "I took the candle back to Mark. He called the debt paid and Wat finished with."
    },
    {
      "at": 40,
      "ends": true,
      "log": "I told Mark what Wat said. He wrote the debt off and said he would remember it."
    }
  ],
  "topics": [
    {
      "key": "debt",
      "label": "Mark's money",
      "when": {
        "cast": "debtor",
        "of": "wats-debt"
      },
      "infos": [
        {
          "when": {
            "quest": "wats-debt",
            "done": 20
          },
          "reply": "I said what I said. Go and say it to him."
        },
        {
          "reply": "Mark sent you? Then tell Mark this: he weighed it twice and I paid for it twice. He can have the rest when he gives one of them back.",
          "then": [
            {
              "do": "setStage",
              "quest": "wats-debt",
              "stage": 20
            }
          ]
        }
      ]
    },
    {
      "key": "debt-press",
      "label": "He will not wait",
      "when": {
        "all": [
          {
            "cast": "debtor",
            "of": "wats-debt"
          },
          {
            "quest": "wats-debt",
            "done": 20
          },
          {
            "not": {
              "quest": "wats-debt",
              "done": 25
            }
          }
        ]
      },
      "infos": [
        {
          "reply": "Fine. Fine. Here — the candle he sold me. Take it back to him and he can choke on it.",
          "then": [
            {
              "do": "giveItem",
              "builder": "candle",
              "seed": 7102
            },
            {
              "do": "setStage",
              "quest": "wats-debt",
              "stage": 25
            }
          ]
        }
      ]
    },
    {
      "key": "debt-back",
      "label": "About Wat",
      "when": {
        "all": [
          {
            "cast": "creditor",
            "of": "wats-debt"
          },
          {
            "quest": "wats-debt",
            "done": 20
          }
        ]
      },
      "infos": [
        {
          "when": {
            "any": [
              {
                "quest": "wats-debt",
                "done": 30
              },
              {
                "quest": "wats-debt",
                "done": 40
              }
            ]
          },
          "reply": "Wat is done with, one way or the other. Do not bring him up."
        },
        {
          "when": {
            "all": [
              {
                "quest": "wats-debt",
                "done": 25
              },
              {
                "carries": "candle"
              }
            ]
          },
          "reply": "That is my candle. Well. Paid, then, and I will not sell to him again.",
          "then": [
            {
              "do": "takeItem",
              "builder": "candle"
            },
            {
              "do": "setStage",
              "quest": "wats-debt",
              "stage": 30
            }
          ]
        },
        {
          "reply": "Weighed it twice. Weighed it — no. Leave it. I will write it off, and I will remember.",
          "then": [
            {
              "do": "setStage",
              "quest": "wats-debt",
              "stage": 40
            }
          ]
        }
      ]
    }
  ]
}
