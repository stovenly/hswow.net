{
  "id": "bess-debt",
  "name": "What Bess Owes",
  "cast": {
    "creditor": "mark",
    "debtor": "bess"
  },
  "stages": [
    {
      "at": 10,
      "log": "Mark says Bess, who spins in the workshop on the east side of the green, owes him for two winters of candles. I am to stand in her door until she pays."
    },
    {
      "at": 20,
      "log": "Bess says Mark weighed it twice and she paid twice. He can have the rest when he gives one of them back."
    },
    {
      "at": 25,
      "log": "Bess gave me back the candle Mark sold her, and said he can choke on it."
    },
    {
      "at": 30,
      "ends": true,
      "log": "I took the candle back to Mark. He called the debt paid and Bess finished with."
    },
    {
      "at": 40,
      "ends": true,
      "log": "I told Mark what Bess said. He wrote the debt off and said he would remember it."
    }
  ],
  "topics": [
    {
      "key": "debt",
      "label": "Mark's money",
      "when": {
        "cast": "debtor",
        "of": "bess-debt"
      },
      "infos": [
        {
          "when": {
            "quest": "bess-debt",
            "done": 20
          },
          "reply": "I said what I said. Go and say it to him."
        },
        {
          "reply": "Mark sent you? Then tell Mark this: he weighed it twice and I paid for it twice. He can have the rest when he gives one of them back.",
          "then": [
            {
              "do": "setStage",
              "quest": "bess-debt",
              "stage": 20
            }
          ]
        }
      ]
    },
    {
      "key": "debt-press",
      "label": "He will not wait",
      "when": {
        "all": [
          {
            "cast": "debtor",
            "of": "bess-debt"
          },
          {
            "quest": "bess-debt",
            "done": 20
          },
          {
            "not": {
              "quest": "bess-debt",
              "done": 25
            }
          }
        ]
      },
      "infos": [
        {
          "reply": "Fine. Fine. Here — the candle he sold me. Take it back to him and he can choke on it.",
          "then": [
            {
              "do": "giveItem",
              "item": "bess-candle"
            },
            {
              "do": "setStage",
              "quest": "bess-debt",
              "stage": 25
            }
          ]
        }
      ]
    },
    {
      "key": "debt-back",
      "label": "About Bess",
      "when": {
        "all": [
          {
            "cast": "creditor",
            "of": "bess-debt"
          },
          {
            "quest": "bess-debt",
            "done": 20
          }
        ]
      },
      "infos": [
        {
          "when": {
            "any": [
              {
                "quest": "bess-debt",
                "done": 30
              },
              {
                "quest": "bess-debt",
                "done": 40
              }
            ]
          },
          "reply": "Bess is done with, one way or the other. Do not bring her up."
        },
        {
          "when": {
            "item": "bess-candle"
          },
          "reply": "That is my candle. Well. Paid, then, and I will not sell to her again.",
          "then": [
            {
              "do": "takeItem",
              "item": "bess-candle"
            },
            {
              "do": "setStage",
              "quest": "bess-debt",
              "stage": 30
            }
          ]
        },
        {
          "reply": "Weighed it twice. Weighed it — no. Leave it. I will write it off, and I will remember.",
          "then": [
            {
              "do": "setStage",
              "quest": "bess-debt",
              "stage": 40
            }
          ]
        }
      ]
    },
    {
      "key": "debt-where",
      "label": "Bess's debt",
      "when": {
        "all": [
          {
            "cast": "creditor",
            "of": "bess-debt"
          },
          {
            "quest": "bess-debt",
            "stage": {
              "max": 19
            }
          }
        ]
      },
      "infos": [
        {
          "reply": "Have you been to her door yet? The workshop, east side of the green. Stand in it until she remembers me."
        }
      ]
    }
  ]
}
