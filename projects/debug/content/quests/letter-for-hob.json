            "done": 30
          },
          "reply": "You said. Leave it now."
        },
        {
          "reply": "No. Well. It was a long way to walk for one word. Thank you for walking it.",
          "then": [
            {
              "do": "setStage",
              "quest": "letter-for-hob",
              "stage": 30
            }
          ]
        }
