          "reply": "From Nell. Give it here, then.  ...  No. Tell her no, and tell her not to ask me again.",
          "then": [
            {
              "do": "takeItem",
              "builder": "folded-letter"
            },
            {
              "do": "setStage",
              "quest": "letter-for-hob",
              "stage": 20
            }
          ]
        },
        {
          "reply": "You had a letter for me and you have not got it now? Then there is nothing to say, is there.",
          "then": [
            {
              "do": "setStage",
              "quest": "letter-for-hob",
              "stage": 25
            }
          ]
        }
      ]
    },
    {
      "key": "letter-back",
      "label": "Hob's answer",
      "when": {
        "all": [
          {
            "cast": "sender",
            "of": "letter-for-hob"
